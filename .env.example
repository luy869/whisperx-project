# VoiceLens バックエンド用の環境変数。.env にコピーして値を設定してください。
# .env は .gitignore 済み（コミットされません）。

# Hugging Face トークン（pyannote 話者分離モデルのダウンロードに使用）
HF_TOKEN=hf_xxx

# Supabase（認証・DB）
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Gemini API（面接/プレゼン/会議/音楽の分析生成に使用）
gemini_api_key=xxx

# CORS許可オリジン（カンマ区切りで複数可）
ALLOWED_ORIGINS=https://voicelens.luy869.net

# VRAM制約のある環境向け（例: 自宅サーバーでCLIPと同じ6GB GPUを共有する場合）。
# 未設定ならデフォルトの large-v3 / float16 / batch_size=16（開発機など余裕がある環境向け）。
# WHISPERX_MODEL=medium
# WHISPERX_COMPUTE_TYPE=int8
# WHISPERX_BATCH_SIZE=8
